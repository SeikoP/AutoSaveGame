<Window x:Class="AutoSaveGame.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AutoSaveGame.App.ViewModels"
        Title="AutoSaveGame"
        Width="1000"
        Height="700"
        MinWidth="820"
        MinHeight="560"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        KeyboardNavigation.TabNavigation="Continue">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="28,22"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="AutoSaveGame"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextStrongBrush}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="Game saves protected in your private Google Drive app folder"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Margin="0,0,12,0"
                            Padding="12,7"
                            Background="{StaticResource MutedSurfaceBrush}"
                            CornerRadius="16">
                        <TextBlock FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Not connected" />
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                                            <Setter Property="Text" Value="Google Drive connected" />
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Button Margin="0,0,8,0"
                            Content="Sign out"
                            Command="{Binding SignOutCommand}"
                            AutomationProperties.Name="Sign out of Google Drive">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Exit"
                            Click="Exit_Click"
                            AutomationProperties.Name="Exit AutoSaveGame" />
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1"
                     Height="4"
                     BorderThickness="0"
                     Foreground="{StaticResource PrimaryBrush}"
                     IsIndeterminate="True"
                     IsTabStop="False"
                     AutomationProperties.Name="Operation progress"
                     Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid Grid.Row="2" Margin="28,24">
            <Border Style="{StaticResource Card}" Padding="40">
                <Grid>
                    <Grid MaxWidth="720"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Bring your game saves with you"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextStrongBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,24"
                                       FontSize="16"
                                       LineHeight="25"
                                       Text="Sign in once for this session. Restore your saves, then let AutoSaveGame protect new changes while you play."
                                       TextWrapping="Wrap" />
                            <Button HorizontalAlignment="Left"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="22,10"
                                    Content="Sign in with Google"
                                    Command="{Binding SignInCommand}"
                                    AutomationProperties.Name="Sign in with Google" />
                        </StackPanel>
                        <Border Grid.Column="2"
                                Padding="22"
                                Background="{StaticResource SoftBlueBrush}"
                                CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="Safe on a public computer"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextStrongBrush}" />
                                <TextBlock Margin="0,10,0,0"
                                           LineHeight="22"
                                           Text="Your Google refresh token stays in memory only and is removed when you exit. Backup files are visible only to this app."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Protected games"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextStrongBrush}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="Each game keeps one verified cloud snapshot."
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Add game"
                                    Click="AddGame_Click"
                                    AutomationProperties.Name="Add a game save folder" />
                        </Grid>

                        <ListBox Grid.Row="1"
                                 Margin="0,20,0,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ItemsSource="{Binding Games}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,12" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GameItemViewModel}">
                                    <Border Padding="18"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="17"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextStrongBrush}" />
                                                    <Border Margin="10,0,0,0"
                                                            Padding="9,3"
                                                            Background="{StaticResource SoftBlueBrush}"
                                                            CornerRadius="10">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Foreground="{StaticResource PrimaryBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Margin="0,7,0,0"
                                                           MaxWidth="460"
                                                           Text="{Binding LocalPath}"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding LocalPath}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Text="{Binding LastBackupText, StringFormat=Last backup: {0}}"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="12" />
                                            </StackPanel>
                                            <WrapPanel Grid.Row="1"
                                                       Margin="0,14,0,0"
                                                       VerticalAlignment="Center">
                                                <CheckBox Margin="0,0,12,0"
                                                          MinHeight="44"
                                                          VerticalContentAlignment="Center"
                                                          Content="Watch"
                                                          IsChecked="{Binding WatchEnabled, Mode=OneWay}"
                                                          Click="Watch_Click"
                                                          AutomationProperties.Name="Watch this save folder" />
                                                <Button Margin="0,0,8,0"
                                                        Content="Restore"
                                                        IsEnabled="{Binding CanRestore}"
                                                        Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Margin="0,0,8,0"
                                                        Content="Backup now"
                                                        Command="{Binding DataContext.BackupNowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Margin="0,0,8,0"
                                                        Click="EditGame_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Content" Value="Edit" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NeedsSaveFolder}" Value="True">
                                                                    <Setter Property="Content" Value="Choose folder" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Style="{StaticResource DangerButton}"
                                                        Content="Remove"
                                                        Command="{Binding DataContext.DeleteGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="430">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="No protected games yet"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextStrongBrush}"
                                       TextAlignment="Center" />
                            <TextBlock Margin="0,8,0,20"
                                       LineHeight="23"
                                       Text="Choose a save folder. AutoSaveGame creates and verifies the first backup immediately."
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                            <Button HorizontalAlignment="Center"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Add your first game"
                                    Click="AddGame_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Padding="28,14"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Grid.Column="1"
                           Margin="20,0,0,0"
                           Text="Only a confirmed cloud backup is safe"
                           Foreground="{StaticResource TextMutedBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>

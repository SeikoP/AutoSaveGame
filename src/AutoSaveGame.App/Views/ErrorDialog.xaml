<Window x:Class="AutoSaveGame.App.Views.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoSaveGame"
        Width="520"
        Height="250"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText"
                   FontSize="20"
                   FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,14,0,18">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
            <TextBlock x:Name="CorrelationText"
                       Margin="0,12,0,0"
                       Foreground="#6B7280" />
        </StackPanel>
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CopyButton"
                    Margin="0,0,8,0"
                    Padding="14,8"
                    Content="Sao chép mã chẩn đoán"
                    Click="Copy_Click" />
            <Button Padding="14,8"
                    Content="Đóng"
                    IsDefault="True"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>

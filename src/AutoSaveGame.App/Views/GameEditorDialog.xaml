<Window x:Class="AutoSaveGame.App.Views.GameEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game configuration"
        Width="560"
        Height="250"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Game name" FontWeight="SemiBold" />
        <TextBox x:Name="GameNameTextBox"
                 Grid.Row="1"
                 Margin="0,6,0,14"
                 Padding="8" />
        <TextBlock Grid.Row="2"
                   Text="Save folder"
                   FontWeight="SemiBold"
                   VerticalAlignment="Top" />
        <Grid Grid.Row="2" Margin="0,28,0,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SavePathTextBox" Padding="8" />
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="14,8"
                    Content="Browse"
                    Click="Browse_Click" />
        </Grid>
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Padding="16,8"
                    Margin="0,0,8,0"
                    Content="Cancel"
                    IsCancel="True" />
            <Button Padding="16,8"
                    Content="Save"
                    IsDefault="True"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>

